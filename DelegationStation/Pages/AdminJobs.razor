@page "/AdminJobs"
@using DelegationStationShared.Enums
@using DelegationStation.Interfaces

@inject IAdminJobDBService adminJobDBService
@inject NavigationManager nav
@inject ILogger<AdminJobs> logger

@attribute [Authorize]

<h3>Admin Operations</h3>

<AuthorizeView Policy="DelegationStationAdmin">
    <Authorized>

        <button type="button" class="btn btn-secondary mb-3" @onclick=@(() => nav.NavigateTo("/AdminJobs/TagConsolidation/New"))>+ New Tag Consolidation</button>
        <button type="button" class="btn btn-outline-secondary mb-3 ms-2" @onclick=RefreshAsync>Refresh</button>

        @if (!string.IsNullOrEmpty(userMessage))
        {
            <div class="alert alert-danger" role="alert">@userMessage</div>
        }

        @if (loading)
        {
            <p>Loading...</p>
        }
        else if (jobs.Count == 0)
        {
            <p>No admin jobs have been run yet.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Job Type</th>
                        <th>Status</th>
                        <th>Progress</th>
                        <th>Started By</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in jobs)
                    {
                        <tr class="clickable" @onclick=@(() => nav.NavigateTo($"/AdminJobs/{job.Id}"))>
                            <td>@job.JobType</td>
                            <td>@job.Status</td>
                            <td>@job.ProcessedCount / @job.TotalCount (@job.SuccessCount ok, @job.FailureCount failed)</td>
                            <td>@job.StartedByUserName</td>
                            <td>@job.CreatedUTC.ToLocalTime()</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

    </Authorized>
    <NotAuthorized>
        <h3>Not Authorized</h3>
        <p>User is unable to view or run admin operations.</p>
    </NotAuthorized>
</AuthorizeView>
